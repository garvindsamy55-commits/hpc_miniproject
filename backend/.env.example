# ==============================================================================
# CloudBurst Backend Configuration
# ==============================================================================
# Operating Mode: "local" (Default - zero Azure credentials needed) or "azure"
OPERATING_MODE=local

# Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=True
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Worker & Processing Engine Settings
DEFAULT_WORKER_COUNT=4
MAX_WORKER_COUNT=16
MAX_FILE_SIZE_MB=50

# Storage Paths (Local storage root)
STORAGE_DIR=storage
UPLOADS_DIR=storage/uploads
RESULTS_DIR=storage/results
SAMPLES_DIR=storage/samples
DATABASE_URL=sqlite:///./storage/cloudburst.db

# ==============================================================================
# Azure Cloud Mode Configuration (Required ONLY when OPERATING_MODE=azure)
# Standard Azure credential resolution is used:
# 1. Connection String (AZURE_STORAGE_CONNECTION_STRING) — recommended for dev
# 2. Service Principal (AZURE_CLIENT_ID + AZURE_CLIENT_SECRET + AZURE_TENANT_ID)
# 3. Managed Identity (automatically used when running on Azure VMs / App Service)
# NEVER commit real credentials to source control!
# ==============================================================================
AZURE_REGION=eastus
AZURE_STORAGE_ACCOUNT_NAME=cloudburstdemostorage
AZURE_STORAGE_CONNECTION_STRING=
AZURE_BLOB_INPUT_CONTAINER=cloudburst-input-container
AZURE_BLOB_OUTPUT_CONTAINER=cloudburst-output-container
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
